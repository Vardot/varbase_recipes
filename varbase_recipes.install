<?php

/**
 * @file
 * Install and uninstall hooks for the Varbase Recipes module.
 */

/**
 * Implements hook_install().
 *
 * Automatically enable the varbase_recipes source in Project Browser.
 */
function varbase_recipes_install() {
  $config = \Drupal::configFactory()->getEditable('project_browser.admin_settings');
  $enabled = $config->get('enabled_sources') ?? [];

  if (!array_key_exists('varbase_recipes', $enabled)) {
    $enabled['varbase_recipes'] = [];
    $config->set('enabled_sources', $enabled)->save();
  }

  // Clear any stale project_browser applied-recipes state for varbase_*
  // recipes. When the Varbase profile applies recipes during installation,
  // it stores their paths in state. Later config drift (from other applied
  // recipes) can cause RecipePreExistingConfigException when Project Browser
  // tries to render the recipe list. Clearing the state here resets varbase
  // recipes to "Present" status so the list renders without errors.
  $state = \Drupal::state();
  $applied = $state->get('project_browser.applied_recipes', []);
  $applied = array_values(array_filter($applied, static function (string $path): bool {
    return !str_contains(basename($path), 'varbase_');
  }));
  $state->set('project_browser.applied_recipes', $applied);
}

/**
 * Implements hook_uninstall().
 *
 * Remove the varbase_recipes source when the module is uninstalled.
 */
function varbase_recipes_uninstall() {
  $config = \Drupal::configFactory()->getEditable('project_browser.admin_settings');
  $enabled = $config->get('enabled_sources') ?? [];

  if (array_key_exists('varbase_recipes', $enabled)) {
    unset($enabled['varbase_recipes']);
    $config->set('enabled_sources', $enabled)->save();
  }
}
